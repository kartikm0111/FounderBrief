# Signal Stack Configuration
PROJECT_NAME="Signal Stack - Company Intelligence Engine"
DATABASE_URL="sqlite:///./signal_stack.db"

# Free-Tier LLM APIs (Provide at least one)
# Google Gemini Free API (Get from: https://aistudio.google.com/)
GEMINI_API_KEY=""

# Groq Free API (Get from: https://console.groq.com/)
GROQ_API_KEY=""

# Active Provider: "gemini" or "groq"
LLM_PROVIDER="gemini"
LLM_MODEL="gemini-2.5-flash"

# Ethical Crawler settings
DEFAULT_USER_AGENT="SignalStackBot/1.0 (+https://signalstack.local; Ethical Academic Intelligence Agent)"
CRAWL_TIMEOUT_SECONDS=15
RESPECT_ROBOTS_TXT=True
